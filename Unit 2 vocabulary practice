do housework|házimunkát végez
dust|portalanít, letörli a port
house renovation|háztatarozás / felújítás
mend|megjavít
move in / out|beköltözik / kiköltözik
renovate / do up|helyreállít / rendbehoz`,
"Other words":`accommodation|szállás
arrange a flat|lakást közvetít
Croydon district|Croydon kerület, körzet
do the cleaning / cooking / ironing / washing-up|kitakarít / megfőz / kivasal / elmosogat
electricity / telephone bill|villany- / telefonszámla
estate agent / agency|ingatlanügynök / ingatlanügynökség
flatmate|lakótárs
for sale|eladó
housing estate|lakótelep
I live at 1 Petőfi Street, flat 1.|A Petőfi út 1. szám alatt az 1-es számú lakásban lakom.
in the centre|a központban
In the neighbourhood there is a school.|A környéken van egy iskola.
in the suburbs|a kertvárosban
landlord / landlady|főbérlő
live on the first / second floor|az első / második emeleten lakik
located in a residential area|egy lakónegyedben található
lower / increase the rent|csökkenti / emeli a bérleti díjat
multi-storey building|többemeletes épület
neighbour|szomszéd
pay (high / low) rent|magas / alacsony bérleti díjat fizet
pay the bills|kiegyenlíti a számlát
rent a flat / room from sb|lakást / szobát bérel valakitől
rent a flat / room to sb|lakást / szobát bérel valaki számára
rural|vidéki
share a room|megosztja a szobát valakivel
take the rubbish out|kiviszi a szemetet
tenant|főbérlő, lakó
urban|városi
We had our house renovated / done up last year.|Tavaly tataroztattuk / újíttattuk fel a házunkat.`
};
const CARDS = [];
for (const [cat, txt] of Object.entries(RAW)) txt.split("\n").forEach(l => {
  const [en, hu] = l.split("|"); CARDS.push({ id: CARDS.length, cat, en: en.trim(), hu: hu.trim() });
});

const $ = id => document.getElementById(id);
const store = { get(k, d){ try { const v = localStorage.getItem(k); return v ? JSON.parse(v) : d } catch(e){ return d } },
                set(k, v){ try { localStorage.setItem(k, JSON.stringify(v)) } catch(e){} } };

let cat = store.get("hf-cat", "All");
let dir = store.get("hf-dir", "en");
let queue = [], total = 0, known = 0, flipped = false;

function shuffle(a){ for (let i = a.length - 1; i > 0; i--){ const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]] } return a }

function renderRooms(){
  const cats = ["All", ...Object.keys(RAW)];
  $("rooms").innerHTML = cats.map(c => {
    const n = c === "All" ? CARDS.length : CARDS.filter(x => x.cat === c).length;
    return `<button class="chip" data-cat="${c}" aria-pressed="${c === cat}">${c}<small>${n}</small></button>`;
  }).join("");
}
function start(){
  const pool = CARDS.filter(c => cat === "All" || c.cat === cat);
  queue = shuffle(pool.slice()); total = pool.length; known = 0;
  $("done").hidden = true; $("stage").hidden = false; $("actions").hidden = false;
  show();
}
function show(){
  if (!queue.length){ finish(); return }
  const c = queue[0];
  setFlip(false);
  const f = dir === "en" ? c.en : c.hu, b = dir === "en" ? c.hu : c.en;
  $("front").textContent = f; $("back").textContent = b;
  $("tag-f").textContent = $("tag-b").textContent = c.cat;
  $("lang-f").textContent = dir === "en" ? "English" : "Magyar";
  $("lang-b").textContent = dir === "en" ? "Magyar" : "English";
  $("back-hint").textContent = dir === "en" ? c.en : "";
  progress();
}
function progress(){
  $("fill").style.width = (total ? known / total * 100 : 0) + "%";
  $("count").textContent = `${known} / ${total} known · ${queue.length} left`;
}
function setFlip(v){ flipped = v; $("card").classList.toggle("flipped", v) }
function answer(ok){
  if (!queue.length) return;
  if (!flipped){ setFlip(true); return }   // first press reveals the answer
  const c = queue.shift();
  if (ok) known++;
  else queue.splice(Math.min(queue.length, 3 + Math.floor(Math.random() * 3)), 0, c); // comes back soon
  show();
}
function finish(){
  $("stage").hidden = true; $("actions").hidden = true; $("done").hidden = false;
  $("done-text").textContent = `You went through all ${total} words in “${cat}”. Try the other direction next time!`;
  progress();
}
function say(){
  const c = queue[0]; if (!c || !("speechSynthesis" in window)) return;
  try { speechSynthesis.cancel(); const u = new SpeechSynthesisUtterance(c.en); u.lang = "en-GB"; u.rate = .9; speechSynthesis.speak(u) } catch(e){}
}
function setDir(d){ dir = d; store.set("hf-dir", d);
  $("dir-en").setAttribute("aria-pressed", d === "en"); $("dir-hu").setAttribute("aria-pressed", d === "hu"); start() }

$("rooms").addEventListener("click", e => { const b = e.target.closest(".chip"); if (!b) return;
  cat = b.dataset.cat; store.set("hf-cat", cat); renderRooms(); start() });
$("card").addEventListener("click", () => setFlip(!flipped));
$("know").addEventListener("click", () => answer(true));
$("again").addEventListener("click", () => answer(false));
$("shuffle").addEventListener("click", start);
$("restart").addEventListener("click", start);
$("sayBtn").addEventListener("click", say);
$("dir-en").addEventListener("click", () => setDir("en"));
$("dir-hu").addEventListener("click", () => setDir("hu"));
document.addEventListener("keydown", e => {
  if (e.target.closest && e.target.closest(".chip,.mode")) return;
  if (e.key === " "){ e.preventDefault(); setFlip(!flipped) }
  else if (e.key === "ArrowRight") answer(true);
  else if (e.key === "ArrowLeft") answer(false);
});

if (!["All", ...Object.keys(RAW)].includes(cat)) cat = "All";
$("dir-en").setAttribute("aria-pressed", dir === "en"); $("dir-hu").setAttribute("aria-pressed", dir === "hu");
renderRooms(); start();
</script>
</body>
</html>
